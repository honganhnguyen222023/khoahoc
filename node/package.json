{
  "name": "khoahoc-node",
  "version": "0.1.0",
  "private": true,
  "description": "KhoaHoc Academy viết lại bằng Node.js (Next.js + Prisma)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push --skip-generate && prisma generate",
    "db:studio": "prisma studio",
    "import:wp": "node scripts/import-wordpress.mjs",
    "setup": "npm run db:push && npm run import:wp"
  },
  "engines": { "node": ">=18.18" },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@wordpress/block-serialization-default-parser": "5.40.1",
    "bcryptjs": "3.0.3",
    "next": "15.5.29",
    "nodemailer": "6.10.1",
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/nodemailer": "6.4.17",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  }
}
